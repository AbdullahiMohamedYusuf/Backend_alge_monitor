   1:main.c        **** ////////////// VERSION 7 ////////////////////////
   2:main.c        **** /*
   3:main.c        ****  * main_mcu.c  –  Algae-Halt sensor firmware
   4:main.c        ****  * Target: GD32VF103 @ 108 MHz
   5:main.c        ****  *
   6:main.c        ****  * Reads:
   7:main.c        ****  *   - pH via ADC (ADC0, channel 1)
   8:main.c        ****  *   - Turbidity (NTU) via ADC (ADC0, channel 0) – DFRobot SEN0189
   9:main.c        ****  *   - Temperature via DS18B20 on 1-Wire (PB5)
  10:main.c        ****  *
  11:main.c        ****  * Emits over USB-CDC every ~2 s:
  12:main.c        ****  *   SENSOR pH=7.2 temp=23.45 Turbidity=12.3 Voltage=1.6\r\n
  13:main.c        ****  *
  14:main.c        ****  * The GUI (main_gui.c) parses that line on COM8.
  15:main.c        ****  */
  16:main.c        **** 
  17:main.c        **** #include "gd32vf103.h"
  18:main.c        **** #include "usb_serial_if.h"
  19:main.c        **** #include "usb_delay.h"
  20:main.c        **** #include <adc.h>
  21:main.c        **** #include <lioonewire.h>
  22:main.c        **** #include <math.h>
  23:main.c        **** #include <stdlib.h>
  24:main.c        **** #include <string.h>
  25:main.c        **** #include <stdio.h>
  26:main.c        **** 
  27:main.c        **** #define USE_USB
  28:main.c        **** #define USE_USB_PRINTF
  29:main.c        **** 
  30:main.c        **** // ── pH calibration ────────────────────────�
  31:main.c        **** #define PH_OFFSET_MV 1272.8f    // mV at pH 7.0 (calibrate against buffer)
  32:main.c        **** #define MV_PER_PH    170.4341f  // mV per pH unit  (Nernst ~59.16 mV/pH @ 25 °C)
  33:main.c        **** #define PH_NEUTRAL   7.0f
  34:main.c        **** 
  35:main.c        **** // ── Turbidity calibration ──────────────────────�
  36:main.c        **** // SEN0189 parabola has its peak at V ≈ 2.56 V (NTU ≈ 3000),
  37:main.c        **** // and a right-hand zero (clear water) at V ≈ 4.20 V.
  38:main.c        **** // Only the interval 2.56 V < V < 4.20 V is physically valid.
  39:main.c        **** #define NTU_V_PEAK         2.56f
  40:main.c        **** #define NTU_V_CLEAR        4.20f
  41:main.c        **** #define NTU_MAX            3000.0f
  42:main.c        **** #define NTU_EXTRAP_SLOPE   1500.0f   // tweak: extra NTU per V_PEAK below peak
  43:main.c        **** 
