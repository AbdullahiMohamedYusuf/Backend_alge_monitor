 100:main.c        ****     else {
 101:main.c        ****         // Below the peak the parabola is non-monotonic and unreliable.
 102:main.c        ****         // Linear extrapolation so very murky samples (e.g. coffee) still
 103:main.c        ****         // produce a varying reading instead of clamping flat at 3000.
 104:main.c        ****         //   v = V_PEAK -> NTU_MAX
